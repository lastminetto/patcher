@page "/settings"
@attribute [Authorize(Policy = "Admin")]
@inherits LiveComponentBase
@inject StateStore Store
@inject SettingsService SettingsSvc
@inject SecretsService Secrets
@inject DiscoveryService Discovery
@inject OperationsService Ops
@inject CurrentUser Who
@inject VaultMonitor Vault
@inject IVulnFeedUpdater Feeds
@inject SchedulerService Scheduler
@inject NavigationManager Nav
@inject IConfiguration Config
@inject IBootstrapScriptProvider Bootstrap
@inject AppCertificatePin CertPin

<PageTitle>Configurações — pve-patcher</PageTitle>
<h1>Configurações</h1>

@if (_msg is not null) { <div class="alert @(_msgErr ? "err" : "ok")">@_msg</div> }

<h2>Cofre e base de CVEs</h2>
<div class="panel">
    <p>Cofre: <span class="badge @(Vault.IsReady ? "b-ok" : "b-err")">@Vault.Current.State</span> <span class="muted">@Vault.Current.Detail</span></p>
    <div class="tablewrap"><table>
        <thead><tr><th>Feed</th><th>Atualizado</th><th class="num">Registros</th><th>Erro</th></tr></thead>
        <tbody>
        @foreach (var f in _feeds) { <tr><td>@f.Name</td><td>@Fmt.Date(f.UpdatedAt)</td><td class="num">@f.Records</td><td>@f.LastError</td></tr> }
        @if (_feeds.Count == 0) { <tr><td colspan="4" class="muted">Sem informação de feeds.</td></tr> }
        </tbody>
    </table></div>
    <div class="row" style="margin-top:.6rem"><button @onclick="UpdateFeedsAsync">Atualizar base de CVEs</button></div>
    <label class="field" style="margin-top:.6rem"><span>Chave de API do NVD (@SecretStatus(_nvdExists, SecretsService.MarkNvd); o valor nunca é exibido)</span>
        <input type="password" @bind="_nvdKey" autocomplete="off" placeholder="nova chave" /></label>
    <button @onclick="SaveNvdAsync" disabled="@string.IsNullOrWhiteSpace(_nvdKey)">Gravar no cofre</button>
</div>

<h2>Clusters Proxmox</h2>
<div class="tablewrap"><table>
    <thead><tr><th>Id</th><th>Nome</th><th>Endpoints</th><th>Token (cofre)</th><th>Discovery</th><th></th></tr></thead>
    <tbody>
    @foreach (var c in _clusters)
    {
        <tr>
            <td class="mono">@c.Id</td><td>@c.Name</td><td class="mono">@string.Join(", ", c.Endpoints)</td>
            <td>@SecretStatus(_tokenExists.GetValueOrDefault(c.Id), SecretsService.MarkCluster(c.Id))</td>
            <td>@if (c.LastDiscoveryError is not null) { <span class="badge b-err" title="@c.LastDiscoveryError">erro</span> } else { @Fmt.Relative(c.LastDiscoveryAt, Time.GetUtcNow()) }</td>
            <td class="right nowrap">
                <button class="small" @onclick="() => TestAsync(c)">Testar</button>
                <button class="small" @onclick="() => EditCluster(c)">Editar</button>
                <button class="small danger" @onclick="() => DeleteClusterAsync(c)">Remover</button>
            </td>
        </tr>
    }
    </tbody>
</table></div>

<div class="panel" style="margin-top:1rem">
    <h3>@(_editing ? "Editar cluster" : "Novo cluster")</h3>
    <label class="field"><span>Id (slug, usado no cofre)</span><input type="text" @bind="_cId" disabled="@_editing" placeholder="prod" /></label>
    <label class="field"><span>Nome</span><input type="text" @bind="_cName" /></label>
    <label class="field"><span>Endpoints (um por linha, ex.: https://172.22.1.10:8006)</span><textarea rows="3" @bind="_cEndpoints"></textarea></label>
    <label class="field"><span>Fingerprints SHA-256 dos certificados (uma impressão SHA-256 por nó, saída do pve-role.sh; vazio = validar pela cadeia do sistema)</span><textarea rows="3" @bind="_cFp"></textarea></label>
    <button class="primary" @onclick="SaveClusterAsync">Salvar cluster</button>
    @if (_editing) { <button @onclick="ResetClusterForm">Cancelar</button> }

    @if (_editing)
    {
        <h3>Token de API (gravado no cofre)</h3>
        <label class="field"><span>token_id (user@realm!nome)</span><input type="text" @bind="_tId" autocomplete="off" /></label>
        <label class="field"><span>token_secret</span><input type="password" @bind="_tSecret" autocomplete="off" /></label>
        <button @onclick="SaveTokenAsync" disabled="@(string.IsNullOrWhiteSpace(_tId) || string.IsNullOrWhiteSpace(_tSecret))">Gravar token</button>
    }
</div>

<h2>Chave SSH padrão</h2>
<div class="panel">
    <p>Chave privada: @SecretStatus(_sshExists, SecretsService.MarkSsh) <span class="muted">(o valor nunca é exibido)</span></p>
    @if (_pub is not null)
    {
        <p>Chave pública:</p><code class="cmd">@_pub</code>
        <h3>Comando de bootstrap</h3>
        <div class="row">
            <label class="grow">URL do app vista pelas VMs
                <input type="text" @bind="_bootUrl" placeholder="@($"padrão: {ConfigOrPageUrl}")" autocomplete="off" style="width:100%" /></label>
            <label>Certificado no curl
                <select @bind="_bootTls">
                    <option value="">Automático (appsettings: @(Config.GetValue("Bootstrap:PinAppCertificate", true) ? "pin" : "cadeia"))</option>
                    <option value="@BootstrapLink.TlsPin">Pinar a chave do app (acesso direto, autoassinado)</option>
                    <option value="@BootstrapLink.TlsChain">Validar a cadeia (proxy com certificado confiável)</option>
                </select></label>
            <button @onclick="SaveBootstrapAsync" disabled="@(!BootstrapDirty)">Salvar</button>
        </div>
        @if (BootstrapLink.UsePin(BaseUrl, SettingsSvc.Current.BootstrapTls, Config.GetValue("Bootstrap:PinAppCertificate", true)) && BootstrapPin is null)
        {
            <div class="alert">Pin pedido, mas o certificado do app não foi encontrado: o comando sai sem pin.</div>
        }
        <p style="margin-top:.8rem">Comando para preparar uma VM (rode como root na VM):</p>
        <code class="cmd">@Bootstrap.Command(BaseUrl + "/bootstrap-vm.sh", _pub, BootstrapUser, null, BootstrapPin)</code>
        <p class="muted" style="margin-top:.4rem">Cria o usuário <code>@BootstrapUser</code>, autoriza esta chave e grava um sudoers que libera só o update e o upgrade
            do gerenciador de pacotes, o reboot e o <code>/usr/local/sbin/patcher-upgrade</code> (upgrade seletivo, valida os nomes).
            O agente continua indo pela conexão SSH a cada execução. Rode de novo após atualizar o app ou trocar a chave.
            @if (SettingsSvc.Current.SshUser == "root") { <strong>O usuário SSH salvo ainda é root: troque para @BootstrapUser em "Agendamento e geral" depois do bootstrap.</strong> }</p>
    }
    <div class="row" style="margin-top:.8rem">
        <button @onclick="GenerateKeyAsync" disabled="@_busy">Gerar novo par ed25519</button>
        <span class="muted">Substitui a chave atual; as VMs precisarão da nova pública (rode o bootstrap de novo).</span>
    </div>
    <details><summary>Colar uma chave existente</summary>
        <label class="field"><span>Chave privada (OpenSSH/PEM)</span><textarea rows="5" @bind="_pastePriv"></textarea></label>
        <label class="field"><span>Chave pública (para exibição)</span><input type="text" @bind="_pastePub" style="max-width:100%" /></label>
        <label class="field"><span>Passphrase (se houver)</span><input type="password" @bind="_pastePass" autocomplete="off" /></label>
        <button @onclick="PasteKeyAsync" disabled="@string.IsNullOrWhiteSpace(_pastePriv)">Gravar no cofre</button>
    </details>
</div>

<h2>Terminal SSH</h2>
<div class="panel">
    <p class="muted">Chave e usuário usados só pelo <a href="terminal" target="_blank">terminal</a> da interface, iguais para todas as VMs.
        Qualquer usuário logado no app pode abrir o terminal; cada sessão fica registrada no log do serviço.
        Prepare a conta nas VMs com o comando abaixo (ou use um certificado da sua CA SSH).</p>
    <div class="row">
        <label>Usuário <input type="text" @bind="_consoleUser" autocomplete="off" style="width:12rem" /></label>
        <button @onclick="SaveConsoleUserAsync" disabled="@(_consoleUser.Trim() == SettingsSvc.Current.ConsoleUser)">Salvar usuário</button>
    </div>
    <p>Chave privada: @SecretStatus(_consoleExists, SecretsService.MarkConsole) <span class="muted">(o valor nunca é exibido)</span>
        @if (_consoleHasCert) { <span class="badge b-ok">com certificado</span> }</p>
    @if (_consolePub is not null)
    {
        <p>Chave pública:</p><code class="cmd">@_consolePub</code>
        <h3>Preparo da conta</h3>
        <p>Comando para conferir e ajustar a conta <code>@SettingsSvc.Current.ConsoleUser</code> numa VM (rode como root na VM):</p>
        <code class="cmd">@Bootstrap.Command(BaseUrl + "/bootstrap-console.sh", _consolePub, SettingsSvc.Current.ConsoleUser, null, BootstrapPin)</code>
        <p class="muted" style="margin-top:.4rem">O usuário precisa existir na VM (o script não cria contas). Ele confere e corrige só o que faltar:
            a chave no <code>authorized_keys</code> (sem <code>no-pty</code>), as permissões do home e do <code>~/.ssh</code>, a conta
            bloqueada sem senha e o sudo, gravando <code>NOPASSWD: ALL</code> se o sudo pedir senha (o terminal vira admin sem senha
            nessa conta). Da configuração do sshd ele só avisa. Usa a URL e o certificado do comando de bootstrap acima.
            Rode de novo após trocar a chave ou o usuário.</p>
    }
    <div class="row" style="margin-top:.8rem">
        <button @onclick="GenerateConsoleKeyAsync" disabled="@_busy">Gerar novo par ed25519</button>
        <span class="muted">Substitui a chave atual do terminal.</span>
    </div>
    <details><summary>Colar uma chave existente (com certificado opcional)</summary>
        <label class="field"><span>Chave privada (OpenSSH/PEM)</span><textarea rows="5" @bind="_conPriv"></textarea></label>
        <label class="field"><span>Chave pública (para exibição)</span><input type="text" @bind="_conPub" style="max-width:100%" /></label>
        <label class="field"><span>Certificado OpenSSH (conteúdo do <code>-cert.pub</code>, opcional)</span><textarea rows="3" @bind="_conCert"></textarea></label>
        <label class="field"><span>Passphrase (se houver)</span><input type="password" @bind="_conPass" autocomplete="off" /></label>
        <button @onclick="PasteConsoleKeyAsync" disabled="@string.IsNullOrWhiteSpace(_conPriv)">Validar e gravar no cofre</button>
    </details>
</div>

<h2>Agendamento e geral</h2>
<div class="panel">
    <label class="field"><span>Usuário SSH nas VMs (o criado pelo bootstrap; root ou conta com sudo NOPASSWD também funcionam)</span><input type="text" @bind="_s.SshUser" /></label>
    <label class="field"><span>Redes preferidas para escolher o IP (CIDR, uma por linha)</span><textarea rows="3" @bind="_nets"></textarea></label>
    <label class="field"><span>Scan agendado (cron de 5 campos)</span><input type="text" @bind="_s.ScanCron" /></label>
    <label class="field"><span>Fuso horário</span><input type="text" @bind="_s.TimeZone" /></label>
    <label style="display:block;margin-bottom:.6rem"><input type="checkbox" @bind="_s.ScanEnabled" /> scan agendado ligado (próximo: @(Scheduler.NextRun() is { } n ? Fmt.Date(n, _s.TimeZone) : "—"))</label>
    <label class="field"><span>Intervalo do discovery (minutos)</span><input type="number" @bind="_s.DiscoveryMinutes" min="1" /></label>
    <h3>Limiares de severidade</h3>
    <div class="row">
        <label>Crítica CVSS ≥ <input type="number" step="0.1" @bind="_s.CriticalCvss" style="width:5rem" /></label>
        <label>Alta CVSS ≥ <input type="number" step="0.1" @bind="_s.HighCvss" style="width:5rem" /></label>
        <label>Alta se EPSS ≥ <input type="number" step="0.05" @bind="_s.HighEpss" style="width:5rem" /></label>
        <label>Média CVSS ≥ <input type="number" step="0.1" @bind="_s.MediumCvss" style="width:5rem" /></label>
    </div>
    <p class="muted">Os limiares valem para os próximos scans.</p>
    <button class="primary" @onclick="SaveGeneralAsync">Salvar</button>
</div>

@code {
    private AppSettings _s = new();
    private List<ClusterEntity> _clusters = [];
    private List<FeedState> _feeds = [];
    private Dictionary<string, bool?> _tokenExists = [];
    private bool? _nvdExists, _sshExists, _consoleExists;
    private bool _consoleHasCert;
    private string? _consolePub;
    private string _consoleUser = "", _conPriv = "", _conPub = "", _conPass = "", _conCert = "";
    private string? _pub, _msg;
    private bool _msgErr, _editing, _busy;
    private string _nets = "", _nvdKey = "", _pastePriv = "", _pastePub = "", _pastePass = "";
    private string _cId = "", _cName = "", _cEndpoints = "", _cFp = "", _tId = "", _tSecret = "";
    private UserInfo? _user;

    // URL e TLS do bootstrap: tela > appsettings (Bootstrap:PublicBaseUrl / PinAppCertificate) > endereço da página.
    private string ConfigOrPageUrl => BootstrapLink.BaseUrl(null, Config["Bootstrap:PublicBaseUrl"], Nav.BaseUri);
    private string BaseUrl => BootstrapLink.BaseUrl(SettingsSvc.Current.BootstrapBaseUrl, Config["Bootstrap:PublicBaseUrl"], Nav.BaseUri);

    // Pin da chave do certificado do próprio app (autoassinado). Atrás de um proxy, o certificado é outro: use "cadeia".
    private string? BootstrapPin =>
        BootstrapLink.UsePin(BaseUrl, SettingsSvc.Current.BootstrapTls, Config.GetValue("Bootstrap:PinAppCertificate", true))
            ? CertPin.Current() : null;

    private string _bootUrl = "", _bootTls = "";
    private bool BootstrapDirty =>
        _bootUrl.Trim() != SettingsSvc.Current.BootstrapBaseUrl || _bootTls != SettingsSvc.Current.BootstrapTls;

    private Task SaveBootstrapAsync() => Guard(async () =>
    {
        if (!BootstrapLink.TryNormalize(_bootUrl, out var url, out var error)) throw new ArgumentException(error);
        if (_bootTls is not ("" or BootstrapLink.TlsPin or BootstrapLink.TlsChain)) throw new ArgumentException("Modo de certificado inválido.");
        var live = SettingsSvc.Current;
        live.BootstrapBaseUrl = url;
        live.BootstrapTls = _bootTls;
        await SettingsSvc.SaveAsync(live);
        (_s.BootstrapBaseUrl, _s.BootstrapTls, _bootUrl) = (url, _bootTls, url);
        Say("Endereço do bootstrap salvo.");
    });

    // O bootstrap recusa root (o objetivo é uma conta sem root).
    private string BootstrapUser => SettingsSvc.Current.SshUser is { Length: > 0 } u && u != "root" ? u : "patcher";

    protected override async Task OnInitializedAsync()
    {
        _user = await Who.GetAsync();
        var s = SettingsSvc.Current;
        // cópia para edição
        _s = Data.Json.Deserialize<AppSettings>(Data.Json.Serialize(s)) ?? new AppSettings();
        _nets = string.Join('\n', _s.PreferredNetworks);
        _consoleUser = _s.ConsoleUser;
        (_bootUrl, _bootTls) = (_s.BootstrapBaseUrl, _s.BootstrapTls);
        await ReloadAsync();
    }

    protected override Task OnLiveRefreshAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        _clusters = await Store.GetClustersAsync();
        _tokenExists = [];
        foreach (var c in _clusters) _tokenExists[c.Id] = await Secrets.ExistsAsync(SecretPaths.Cluster(c.Id), default);
        _nvdExists = await Secrets.ExistsAsync(SecretPaths.Nvd, default);
        _sshExists = await Secrets.ExistsAsync(SecretPaths.SshDefault, default);
        _pub = await Secrets.GetSshPublicKeyAsync(default);
        var ck = await Secrets.GetConsoleKeyInfoAsync(default);
        _consoleExists = await Secrets.ExistsAsync(SecretPaths.SshConsole, default);
        _consolePub = ck?.PublicKey;
        _consoleHasCert = ck?.HasCertificate == true;
        try { _feeds = (await Feeds.GetStatusAsync(default)).ToList(); } catch { _feeds = []; }
    }

    private string SecretStatus(bool? exists, string mark)
    {
        if (exists is null) return "indisponível (cofre)";
        if (exists == false) return "não definido";
        return SettingsSvc.Current.SecretsSetAt.TryGetValue(mark, out var d) ? $"definido em {Fmt.Date(d)}" : "definido";
    }

    private void Say(string m, bool err = false) { _msg = m; _msgErr = err; }

    private async Task Guard(Func<Task> action)
    {
        try
        {
            OperationsService.Require(_user?.CanAdmin == true, "é preciso Sys.Modify");
            await action();
        }
        catch (VaultUnavailableException ex) { Say(VaultMessages.For(ex), true); }
        catch (Exception ex) { Say(ex.Message, true); }
        await ReloadAsync();
    }

    private Task UpdateFeedsAsync() => Guard(() =>
    {
        Say(Ops.EnqueueFeedUpdate(_user!) is null ? "Já há uma atualização de feeds na fila." : "Atualização de feeds enfileirada (veja a Fila).");
        return Task.CompletedTask;
    });

    private Task SaveNvdAsync() => Guard(async () =>
    {
        await Secrets.SetNvdKeyAsync(_nvdKey, default);
        _nvdKey = "";
        Say("Chave do NVD gravada no cofre.");
    });

    private void EditCluster(ClusterEntity c)
    {
        _editing = true; _cId = c.Id; _cName = c.Name; _cEndpoints = string.Join('\n', c.Endpoints); _cFp = c.Fingerprint ?? "";
        _tId = _tSecret = "";
    }

    private void ResetClusterForm()
    {
        _editing = false; _cId = _cName = _cEndpoints = _cFp = _tId = _tSecret = "";
    }

    private Task SaveClusterAsync() => Guard(async () =>
    {
        var id = _cId.Trim().ToLowerInvariant();
        if (!System.Text.RegularExpressions.Regex.IsMatch(id, "^[a-z0-9][a-z0-9_-]{0,31}$"))
            throw new ArgumentException("Id inválido: use letras minúsculas, números, '-' ou '_'.");
        var eps = _cEndpoints.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        if (eps.Count == 0 || eps.Any(e => !Uri.TryCreate(e, UriKind.Absolute, out var u) || u.Scheme != "https"))
            throw new ArgumentException("Informe ao menos um endpoint https://host:8006.");
        await Store.UpsertClusterAsync(new ClusterEntity
        {
            Id = id, Name = string.IsNullOrWhiteSpace(_cName) ? id : _cName.Trim(),
            Endpoints = eps, Fingerprint = string.IsNullOrWhiteSpace(_cFp) ? null : string.Join(", ", System.Text.RegularExpressions.Regex.Split(_cFp.Trim(), @"[\s,]+")),
        });
        Say($"Cluster {id} salvo. Grave o token para habilitar o discovery.");
        _editing = true; _cId = id;
    });

    private Task SaveTokenAsync() => Guard(async () =>
    {
        await Secrets.SetClusterTokenAsync(_cId, _tId, _tSecret, default);
        _tId = _tSecret = "";
        Say("Token gravado no cofre.");
    });

    private Task DeleteClusterAsync(ClusterEntity c) => Guard(async () =>
    {
        await Store.DeleteClusterAsync(c.Id);
        try { await Secrets.DeleteClusterTokenAsync(c.Id, default); } catch (VaultUnavailableException) { }
        Say($"Cluster {c.Name} removido (VMs e dados dele apagados).");
    });

    private Task TestAsync(ClusterEntity c) => Guard(async () =>
    {
        using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(60));
        var r = await Discovery.TestAsync(c.ToConfig(), cts.Token);
        Say(r.Message, r.Warning);
    });

    private Task GenerateKeyAsync() => Guard(async () =>
    {
        _busy = true;
        _pub = await Secrets.GenerateSshKeyAsync(default);
        _busy = false;
        Say("Novo par ed25519 gerado; a privada ficou só no cofre.");
    });

    private Task PasteKeyAsync() => Guard(async () =>
    {
        await Secrets.SetSshKeyAsync(_pastePriv, _pastePub, _pastePass, default);
        _pastePriv = _pastePub = _pastePass = "";
        Say("Chave gravada no cofre.");
    });

    private Task SaveConsoleUserAsync() => Guard(async () =>
    {
        var u = _consoleUser.Trim();
        if (!System.Text.RegularExpressions.Regex.IsMatch(u, "^[A-Za-z0-9_][A-Za-z0-9_.@-]{0,63}$"))
            throw new ArgumentException("Usuário do terminal inválido.");
        var live = SettingsSvc.Current;
        live.ConsoleUser = u;
        await SettingsSvc.SaveAsync(live);
        _s.ConsoleUser = _consoleUser = u;
        Say("Usuário do terminal salvo.");
    });

    private Task GenerateConsoleKeyAsync() => Guard(async () =>
    {
        _busy = true;
        try { _consolePub = await Secrets.GenerateConsoleKeyAsync(default); }
        finally { _busy = false; }
        Say("Novo par ed25519 do terminal gerado; a privada ficou só no cofre.");
    });

    private Task PasteConsoleKeyAsync() => Guard(async () =>
    {
        await Secrets.SetConsoleKeyAsync(_conPriv, _conPub, _conPass, _conCert, default);
        _conPriv = _conPub = _conPass = _conCert = "";
        Say("Chave do terminal validada e gravada no cofre.");
    });

    private Task SaveGeneralAsync() => Guard(async () =>
    {
        if (!CronHelper.TryParse(_s.ScanCron, out _)) throw new ArgumentException("Expressão cron inválida (5 campos).");
        if (CronHelper.Zone(_s.TimeZone) == TimeZoneInfo.Utc && !_s.TimeZone.Equals("UTC", StringComparison.OrdinalIgnoreCase))
            throw new ArgumentException("Fuso horário desconhecido.");
        var nets = _nets.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        if (nets.Any(n => !System.Net.IPNetwork.TryParse(n, out _))) throw new ArgumentException("CIDR inválido nas redes preferidas.");
        if (string.IsNullOrWhiteSpace(_s.SshUser)) throw new ArgumentException("Usuário SSH obrigatório.");
        _s.PreferredNetworks = nets;
        _s.DiscoveryMinutes = Math.Max(1, _s.DiscoveryMinutes);
        var live = SettingsSvc.Current;
        _s.SecretsSetAt = live.SecretsSetAt;
        await SettingsSvc.SaveAsync(_s);
        Say("Configurações salvas.");
    });
}
