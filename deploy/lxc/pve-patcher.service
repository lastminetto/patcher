[Unit]
Description=pve-patcher (atualizações de VMs Proxmox)
After=network-online.target openbao.service
Wants=network-online.target

[Service]
Type=simple
User=pve-patcher
Group=pve-patcher
WorkingDirectory=/opt/pve-patcher
ExecStart=/opt/pve-patcher/PvePatcher.Web
Restart=on-failure
RestartSec=5

# HTTPS na 8443 com o certificado de /etc/pve-patcher/tls (deploy/lxc/tls-selfsigned.sh); a 8080 só redireciona.
Environment=ASPNETCORE_HTTPS_PORTS=8443
Environment=ASPNETCORE_HTTP_PORTS=8080
Environment=Kestrel__Certificates__Default__Path=/etc/pve-patcher/tls/cert.pem
Environment=Kestrel__Certificates__Default__KeyPath=/etc/pve-patcher/tls/key.pem
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_NOLOGO=1
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
# Config adicional (Bootstrap:Clusters, OpenBao:*) em
# /etc/pve-patcher/appsettings.Production.json, lida pelo próprio Program.cs.
EnvironmentFile=-/etc/pve-patcher/pve-patcher.env

# Endurecimento
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/pve-patcher

[Install]
WantedBy=multi-user.target
