[Unit]
Description=pve-patcher (atualizações de VMs Proxmox)
After=network-online.target openbao.service
Wants=network-online.target

[Service]
Type=simple
User=pve-patcher
Group=pve-patcher
WorkingDirectory=/opt/pve-patcher
ExecStart=/opt/pve-patcher/PvePatcher.Web
Restart=on-failure
RestartSec=5

Environment=ASPNETCORE_URLS=http://0.0.0.0:8080
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_NOLOGO=1
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
# Config adicional (Bootstrap:Clusters, OpenBao:*, Bootstrap:PublicBaseUrl) em
# /etc/pve-patcher/appsettings.Production.json, lida pelo próprio Program.cs.
EnvironmentFile=-/etc/pve-patcher/pve-patcher.env

# Endurecimento
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/pve-patcher

[Install]
WantedBy=multi-user.target
